# ==========================================================
#  Saira (Sayra) - Sovereign AGI / Chief of Staff
#  Copy to .env (ya host ke environment variables me daalo)
# ==========================================================

# --- Groq (LLM) ---
GROQ_API_KEY=your-groq-api-key
# Primary model (best quality)
SAIRA_MODEL=llama-3.3-70b-versatile
# Jab primary fail/limit ho — chhota model alag quota use karta hai
SAIRA_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Sovereign local clone (optional) ---
# Apne PC/server pe Ollama chalao, phir URL daalo — Groq down hone par Sayra
# local model se jawab degi (Railway pe RAM kam hai, isliye wahan optional hai)
# SAIRA_OLLAMA_URL=http://localhost:11434
# SAIRA_OLLAMA_MODEL=llama3.2

# --- Persistent data (Railway volume mount /data) ---
# SAIRA_DATA_DIR=/data

# --- Master access ---
MASTER_PASSWORD=UJJWAL_SAIRA

# --- Aitotech Enterprise bridge (Sayra -> company) ---
# Aitotech-agents (Railway) ka base URL
ENTERPRISE_API_URL=https://aitotech-agents-production.up.railway.app
# (optional) shared secret if /webhooks/n8n auth use karein
ENTERPRISE_API_KEY=

# --- Server ---
PORT=7860
